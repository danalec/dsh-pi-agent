{
  "name": "dsh-pi-loop",
  "version": "0.2.0",
  "description": "Run the Pi coding agent (@earendil-works/pi-coding-agent) as the agent loop inside DeepSeek Harness (@deepseek-ai/dsh): drive pi --mode rpc from the official DSH web UI, swap subagents to pi, zero prompt injection.",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./subagent": {
      "types": "./dist/subagent.d.ts",
      "default": "./dist/subagent.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "LICENSE-MIT",
    "LICENSE-APACHE",
    "LICENSE-COMMERCIAL"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "npm run build",
    "test": "node --test --test-timeout=30000 \"test/*.test.mjs\"",
    "lint": "eslint src test eslint.config.js"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.3",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.3",
    "@deepseek-ai/dsh-scope": "0.2.2-rc.3",
    "@deepseek-ai/dsh-session": "0.2.2-rc.3",
    "@deepseek-ai/dsh-session-persistence": "0.2.2-rc.3",
    "@deepseek-ai/dsh-session-persistence-jsonl": "0.2.2-rc.3",
    "@deepseek-ai/dsh-session-projection": "0.2.2-rc.3",
    "@deepseek-ai/dsh-subagent": "0.2.2-rc.3",
    "@deepseek-ai/dsh-system-prompt": "0.2.2-rc.3",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.3",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.72.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.1.0",
    "@deepseek-ai/dsh-agent": ">=0.2.2-rc.3 <0.3.0",
    "@deepseek-ai/dsh-llm": ">=0.2.2-rc.3 <0.3.0",
    "@deepseek-ai/dsh-scope": ">=0.2.2-rc.3 <0.3.0",
    "@deepseek-ai/dsh-session": ">=0.2.2-rc.3 <0.3.0",
    "@deepseek-ai/dsh-session-persistence": ">=0.2.2-rc.3 <0.3.0",
    "@deepseek-ai/dsh-session-projection": ">=0.2.2-rc.3 <0.3.0",
    "@deepseek-ai/dsh-subagent": ">=0.2.2-rc.3 <0.3.0"
  },
  "overrides": {
    "@deepseek-ai/dsh-*": "0.2.2-rc.3"
  },
  "engines": {
    "node": ">=20.11.0"
  },
  "license": "MIT OR Apache-2.0 OR LicenseRef-Proprietary",
  "types": "dist/index.d.ts",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "dsh-agent",
    "dsh-extensions",
    "pi",
    "pi-coding-agent",
    "pi-extensions",
    "earendil-works",
    "agent-loop",
    "coding-agent",
    "harness",
    "cordis",
    "agent"
  ],
  "author": "Micheleww",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danalec/dsh-pi-loop.git"
  },
  "homepage": "https://github.com/danalec/dsh-pi-loop#readme",
  "bugs": "https://github.com/danalec/dsh-pi-loop/issues"
}
